# ─────────────────────────────────────────────────────────
# Kiwi Frontend Environment Variables (Vite)
# ─────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own values.
# ─────────────────────────────────────────────────────────

# Backend Flask API base URL
VITE_API_BASE_URL=http://localhost:5000

# AWS Cognito configuration
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
VITE_COGNITO_DOMAIN=https://your-cognito-domain.auth.us-east-2.amazoncognito.com

# OIDC redirect URIs (must be whitelisted in Cognito)
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_LOGOUT_URI=http://localhost:5173/